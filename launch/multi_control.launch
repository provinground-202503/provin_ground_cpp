<launch>
    <node pkg="provin_ground" type="multi_global_path_node" name="multi_global_path_node" output="screen" />
    <node pkg="provin_ground" type="multi_local_path_node" name="multi_local_path_node" output="screen" />
    <node pkg="provin_ground" type="network_avoid_path_node" name="network_avoid_path_node" output="screen" />
    <!-- <node pkg="provin_ground" type="network_yolo_path_node" name="network_yolo_path_node" output="screen" /> -->

    <include file="$(find provin_ground)/launch/perception.launch" />

    <!-- <node pkg="provin_ground" type="kt_camera_distance.py" name="kt_camera_distance" output="screen" /> -->
    <node pkg="provin_ground" type="pp_second_1" name="pp_second_1" output="screen" />
    <!-- <node pkg="provin_ground" type="kt_controller_pp" name="kt_controller_pp" output="screen" /> -->
</launch>